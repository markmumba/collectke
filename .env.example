# Server-only HTTPS endpoint that accepts JSON: { name, email, businessName }.
# Leave unset during design work. Requests then return an honest unavailable state.
EARLY_ACCESS_WEBHOOK_URL=

# Server-only HTTPS endpoint for contact enquiries.
# Accepts JSON: { name, email, businessName, topic, message }.
# topic is workflow or general; businessName may be empty.
CONTACT_WEBHOOK_URL=
